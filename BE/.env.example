# ============ DATABASE ============
# Postgres bạn đã có sẵn — thay user/pass/host/port/dbname
DATABASE_URL="postgresql://postgres:password@localhost:5433/airweave?schema=public"

# ============ REDIS ============
# Docker local: redis://localhost:6379 | Production: redis://:password@host:6379
REDIS_URL="redis://localhost:6379"

# ============ APP ============
PORT=3000
NODE_ENV=development
# Origin của FE, phân tách bằng dấu phẩy
CORS_ORIGINS="http://localhost:8080,http://localhost:5173"
# URL public của BE (dùng cho OAuth callback + link ảnh avatar)
APP_URL="http://localhost:3000"
# FE URL để redirect sau khi login Google xong
FRONTEND_URL="http://localhost:8080"

# ============ JWT ============
# Đổi thành chuỗi ngẫu nhiên dài (openssl rand -hex 32)
JWT_ACCESS_SECRET="thay-bang-chuoi-ngau-nhien-that-dai-access"
JWT_REFRESH_SECRET="thay-bang-chuoi-ngau-nhien-that-dai-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# ============ GOOGLE OAUTH ============
# Lấy tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phải là: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============ EXTERNAL API KEYS ============
# https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=""
# https://api.windy.com/keys
WINDY_API_KEY=""
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=""

# ============ AI ============
# Provider: anthropic | openai | gemini | lovable
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
LOVABLE_API_KEY=""

# ============ PUSH (OneSignal) ============
ONESIGNAL_APP_ID="81852d62-86b2-44aa-ab86-2799b8828216"
ONESIGNAL_REST_API_KEY=""

# ============ DEMO ACCOUNT ============
DEMO_EMAIL="demo@airweave.vn"
DEMO_PASSWORD="AirWeave#Demo2026!"

# ============ IoT NODES / ADMIN ============
# Danh sách email được quyền quản trị IoT (admin stats, tạo tổ chức/node, gán node).
# Phân tách bằng dấu phẩy. ĐỂ TRỐNG = mọi tài khoản đăng nhập đều là admin (chỉ nên
# dùng khi dev) — BẮT BUỘC điền trước khi lên production.
ADMIN_EMAILS=""
# Token bí mật để thiết bị phần cứng ESP32 gửi telemetry / tự khai báo node.
# Thiết bị gửi kèm header: x-device-token: <giá trị này>. Để trống = khoá cổng ingest.
DEVICE_INGEST_TOKEN=""
# Bộ giả lập telemetry (demo). Production nên đặt =false và dùng ESP32 thật gửi qua ingest.
IOT_SIMULATOR_ENABLED="true"
# Chu kỳ sinh telemetry giả lập (ms).
IOT_SIMULATOR_INTERVAL_MS="15000"
# Số ngày giữ lại telemetry trước khi cron dọn.
IOT_TELEMETRY_RETENTION_DAYS="7"
